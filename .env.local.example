# Environment Variables for Express Entry Tracker
# Copy this file to `.env.local` and adjust as needed

# CORS Proxy Configuration (for development only)
# The app will automatically use corsproxy.io when running on localhost
# You can override this by setting NEXT_PUBLIC_IRCC_DATA_URL

# Option 1: Use corsproxy.io (default for localhost)
# NEXT_PUBLIC_IRCC_DATA_URL=https://corsproxy.io/?https://www.canada.ca/content/dam/ircc/documents/json/ee_rounds_123_en.json

# Option 2: Use allorigins.win
# NEXT_PUBLIC_IRCC_DATA_URL=https://api.allorigins.win/raw?url=https://www.canada.ca/content/dam/ircc/documents/json/ee_rounds_123_en.json

# Option 3: Use your own local CORS proxy (if running one)
# NEXT_PUBLIC_IRCC_DATA_URL=http://localhost:8080/https://www.canada.ca/content/dam/ircc/documents/json/ee_rounds_123_en.json

# Option 4: Direct URL (will fail in browser due to CORS, but works in production after static export)
# NEXT_PUBLIC_IRCC_DATA_URL=https://www.canada.ca/content/dam/ircc/documents/json/ee_rounds_123_en.json

# Feature Flags (on/off)
NEXT_PUBLIC_FEATURE_TABLE_DRAG=on
NEXT_PUBLIC_FEATURE_TABLE_RESIZE=on
NEXT_PUBLIC_FEATURE_STATS_ANIMATIONS=on
NEXT_PUBLIC_FEATURE_A11Y_CHECKS=on

# Polling Interval (milliseconds) - default is 3600000 (1 hour)
# NEXT_PUBLIC_DEFAULT_POLL_INTERVAL_MS=3600000
